# Runtime
ENVIRONMENT=development
# Enable after applying the additive advisor_conversations migration.
ADVISOR_HISTORY_ENABLED=false
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082,http://127.0.0.1:8082
MAX_FILE_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=500
MAX_SOURCE_FILES=1000
MAX_SOURCE_FILE_SIZE_MB=2
MAX_LOG_ENTRIES=100000
GIT_CLONE_TIMEOUT_SECONDS=120

# Supabase PostgreSQL
# Use a restricted runtime role for the API/worker and the owner connection only for Alembic.
DATABASE_URL=postgresql+asyncpg://threatlens_backend:REPLACE_ME@HOST:5432/postgres?ssl=require
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:REPLACE_ME@HOST:5432/postgres?ssl=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Supabase Auth and private Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
# Public project gateway key for Auth validation (also reads VITE_SUPABASE_PUBLISHABLE_KEY locally).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCAN_BUCKET=scan-inputs
SUPABASE_REPORT_BUCKET=audit-reports
SIGNED_URL_TTL_SECONDS=300
SOURCE_RETENTION_HOURS=24
AUDIT_WORKBENCH_ENABLED=true
SNAPSHOT_RETENTION_HOURS=720
SUPABASE_SOURCE_BUCKET=audit-source
AUDIT_WORKBENCH_PROGRESSIVE_ENABLED=false

# GitHub App repository authorization (separate from Supabase GitHub sign-in).
# Keep disabled until the additive migration and isolated repository smoke test pass.
GITHUB_ENABLED=false
GITHUB_PUBLISH_ENABLED=false
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/v1/github/callback
GITHUB_FRONTEND_URL=http://127.0.0.1:5173

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=compliance_knowledge
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_TIMEOUT_SECONDS=30

# External APIs
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=30
GROQ_API_KEY=REPLACE_ME
# groq/compound-mini   → fastest free model — use for dev/testing
# groq/compound         → more capable compound model — use for production
GROQ_MODEL=groq/compound-mini
# Legacy unauthenticated API: opt in only on a private development machine.
# Ignored outside ENVIRONMENT=development and DEBUG=true. Never expose through a proxy.
LOCAL_SCAN_ENABLED=false
