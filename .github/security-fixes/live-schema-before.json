    "views": [
      {
        "viewname": "workspaces_with_counts",
        "viewowner": "postgres",
        "definition": " SELECT w.id,\n    w.name,\n    w.slug,\n    w.owner_user_id,\n    w.settings,\n    w.created_at,\n    w.updated_at,\n    COALESCE(wm.member_count, 1) AS member_count,\n    COALESCE(s.scan_count, 0) AS scan_count\n   FROM ((workspaces w\n     LEFT JOIN ( SELECT workspace_members.workspace_id,\n            (count(*))::integer AS member_count\n           FROM workspace_members\n          GROUP BY workspace_members.workspace_id) wm ON ((wm.workspace_id = w.id)))\n     LEFT JOIN ( SELECT scans.workspace_id,\n            (count(*))::integer AS scan_count\n           FROM scans\n          GROUP BY scans.workspace_id) s ON ((s.workspace_id = w.id)));",
        "schemaname": "public"
      }
    ],
