    "functions": [
      {
        "args": "",
        "name": "handle_new_user",
        "schema": "public",
        "definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  insert into public.profiles (id, display_name, email)\n  values (\n    new.id,\n    coalesce(new.raw_app_meta_data->>'display_name', new.raw_user_meta_data->>'display_name', new.raw_user_meta_data->>'full_name', split_part(new.email, '@', 1)),\n    new.email\n  )\n  on conflict (id) do update set\n    email = excluded.email,\n    display_name = coalesce(profiles.display_name, excluded.display_name);\n  return new;\nend; $function$\n"
      },
      {
        "args": "",
        "name": "handle_workspace_created",
        "schema": "public",
        "definition": "CREATE OR REPLACE FUNCTION public.handle_workspace_created()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nBEGIN\n  INSERT INTO public.workspace_members (workspace_id, user_id, role)\n  VALUES (NEW.id, NEW.owner_user_id, 'owner')\n  ON CONFLICT (workspace_id, user_id) DO NOTHING;\n  RETURN NEW;\nEND;\n$function$\n"
      },
      {
        "args": "p_workspace_id uuid",
        "name": "is_workspace_member",
        "schema": "public",
        "definition": "CREATE OR REPLACE FUNCTION public.is_workspace_member(p_workspace_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n    FROM public.workspaces w\n    LEFT JOIN public.workspace_members wm ON wm.workspace_id = w.id\n    WHERE w.id = p_workspace_id\n      AND (\n        (auth.uid() IS NOT NULL AND (w.owner_user_id = auth.uid() OR wm.user_id = auth.uid()))\n        OR (auth.uid() IS NULL AND w.owner_user_id = 'd5e264d7-48cb-457d-b136-a24688f5b633'::uuid)\n      )\n  );\n$function$\n"
      },
      {
        "args": "",
        "name": "set_updated_at",
        "schema": "public",
        "definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
      },
      {
        "args": "p_workspace_id uuid",
        "name": "workspace_user_role",
        "schema": "public",
        "definition": "CREATE OR REPLACE FUNCTION public.workspace_user_role(p_workspace_id uuid)\n RETURNS workspace_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT COALESCE(\n    (\n      SELECT wm.role\n      FROM public.workspace_members wm\n      WHERE wm.workspace_id = p_workspace_id\n        AND wm.user_id = auth.uid()\n      LIMIT 1\n    ),\n    (\n      SELECT 'owner'::public.workspace_role\n      FROM public.workspaces w\n      WHERE w.id = p_workspace_id\n        AND (\n          (auth.uid() IS NOT NULL AND w.owner_user_id = auth.uid())\n          OR (auth.uid() IS NULL AND w.owner_user_id = 'd5e264d7-48cb-457d-b136-a24688f5b633'::uuid)\n        )\n      LIMIT 1\n    )\n  );\n$function$\n"
      }
    ],
    "column_grants": null
  }
