{
  "name": "arch-detective",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"frontend,backend\" -c \"cyan,magenta\" \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite dev --port 5173 --host 127.0.0.1",
    "dev:backend": "python -m uvicorn app.main:app --app-dir threatlens --env-file threatlens/.env --host 127.0.0.1 --port 8000 --reload",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:rls": "node scripts/test-rls.mjs",
    "test:summary": "node --experimental-strip-types tests/scan-summary.test.mjs",
    "test:attack-graph": "node --experimental-strip-types tests/attack-graph.test.mjs",
    "test:audit": "node --experimental-strip-types --test tests/audit-view.test.mjs tests/scan-progress.test.mjs",
    "test:findings": "node --experimental-strip-types --test tests/findings.test.mjs tests/findings-api.test.mjs",
    "test:reports": "node --experimental-strip-types --test tests/reports.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs tests/auth-api.test.mjs tests/auth-bridge.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "^1.167.28",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^0.575.0",
    "monaco-editor": "0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
